DATABASE_URL=sqlite:///./studyagent.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATA_DIR=./data
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=2000000
MAX_CHUNKS=5000
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Optional paragraph-aware splitting; blank byte limit means no extra byte cap.
PARAGRAPH_AWARE_CHUNKS=false
# CHUNK_MAX_UTF8_BYTES=1984
# Base URL should include the API version prefix, e.g. https://your-provider.example/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
TOP_K=5
RETRIEVAL_MIN_SCORE=0.3
RAG_MAX_CONTEXT_CHARS=16000
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_MAX_ANSWER_CHARS=32768

# Phase 4 Agent (uses the same LLM_* provider; no built-in mock fallback)
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_CONTEXT_CHARS=100000

# Phase 5 persistent conversation budgets; no effect on stateless requests
MEMORY_WINDOW_TURNS=10
MEMORY_MAX_CONTEXT_CHARS=24000
MEMORY_SUMMARY_MAX_CHARS=4000
MEMORY_SUMMARY_INPUT_CHARS=24000
CONVERSATION_MAX_PROMPT_CHARS=100000
CONVERSATION_MAX_PROMPT_TOKENS=64000
CONVERSATION_TIMEOUT_SECONDS=180

# Optional HTTP reranker; disabled preserves Basic RAG. No automatic fallback.
ENABLE_RERANKER=false
RERANKER_BASE_URL=
RERANKER_MODEL=
RERANKER_API_KEY=
RERANKER_CANDIDATE_K=20
RERANKER_TIMEOUT_SECONDS=15
RERANKER_MAX_INPUT_CHARS=100000

# Live-test protection: mode alone grants no authorization; sealed ledger + Stage required.
LIVE_TEST_MODE=false
# Loopback-only web mode requires an explicit existing development session.
# Enabling these flags alone does not create a ledger or authorize model calls.
WEB_DEMO_ENABLED=false
WEB_DEMO_ALLOW_WRITES=false
# Optional loopback operator price confirmation UI; no automatic authorization.
WEB_DEMO_ALLOW_SESSION_MANAGEMENT=false
WEB_DEMO_ROUND_ID=
# LIVE_TEST_LEDGER uses the backend/test-results/bailian-first-live/budget.sqlite default.

# Optional explicit HTTP(S) proxy for LLM and Embedding only; blank = direct.
# Windows mixed-port example (NOT enabled here): http://127.0.0.1:7897
# Keep trust_env=False. Proxy credentials must remain private, like API keys.
MODEL_HTTP_PROXY=

# Explicit personal policy requires --personal-learning on the local launcher.
PERSONAL_LEARNING=false
PERSONAL_ALERT_THRESHOLDS=[30,50]
